# Файлы моделей: тяжёлые и почти всегда чужие/клиентские.
# В публичный репозиторий им дороги нет.
*.skp
*.skb
*.layout

data/
uploads/

# SketchUp SDK: чужие бинарники, десятки мегабайт. Ставится локально,
# путь задаётся через ATATA_SDK_PATH.
# Слэш в начале обязателен: без него правило совпадает с любым каталогом
# sdk на любой глубине, включая наш собственный пакет atata/sdk/.
/sdk/

__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

.env
.env.*
!.env.example

.idea/
.vscode/
.DS_Store
Thumbs.db
